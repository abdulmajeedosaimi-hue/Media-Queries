{
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "sass": "^1.77.8"
  },
  "scripts": {
    "sass": "sass styles.scss styles.css --no-source-map",
    "sass:watch": "sass --watch styles.scss:styles.css",
    "prefix": "postcss styles.css --use autoprefixer --replace",
    "build": "npm run sass && npm run prefix"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ]
}
